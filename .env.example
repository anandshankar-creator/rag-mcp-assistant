# ==============================================================================
# Environment Configuration - RAG & MCP Multi-Agent Assistant
# Rename this file to '.env' and fill in your local API keys and configuration.
# ==============================================================================

# LLM Provider Selection: "gemini" (default), "claude", or "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Primary Provider)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude Configuration (Alternative Provider)
# Obtain an API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama Local LLM Configuration (Offline Provider Stub)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Storage & Databases
CHROMA_PERSIST_DIR=./db/chroma
SQLITE_DB_PATH=./db/assistant.db
OUTPUTS_DIR=./outputs

# RAG Hyperparameters
# Similarity threshold below which the retriever refuses to answer (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.30
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Email MCP Tool (Gmail SMTP with App Password)
# To create an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Default Student Preferences
USER_NAME=Alex
USER_DEFAULT_EMAIL=alex.student@ktu.edu.in
DEFAULT_REMINDER_LEAD_HOURS=24
