# ==============================================================================
# Environment Configuration - RAG & MCP Multi-Agent Assistant
# Rename this file to '.env' and fill in your local API keys and configuration.
# ==============================================================================

# LLM Provider Selection: "gemini" (default), "claude", or "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Primary Provider)
# Obtain a free API key at: https://aistudio.google.com/
# Single key:
GEMINI_API_KEY=your_gemini_api_key_here
# Optional multiple keys for automatic quota rotation (comma-separated):
# GEMINI_API_KEYS=key_1,key_2,key_3,key_4
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic Claude Configuration (Alternative Provider)
# Obtain an API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama Local LLM Configuration (Offline Provider Stub)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Storage & Databases
CHROMA_PERSIST_DIR=./db/chroma
SQLITE_DB_PATH=./db/assistant.db
OUTPUTS_DIR=./outputs

# RAG Hyperparameters
# Similarity threshold below which the retriever refuses to answer (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.30
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Web Search Fallback & Domain Trust Ranking
ENABLE_WEB_FALLBACK=true
WEB_SEARCH_MIN_TRUST=0.45

# Email MCP Tool (Gmail SMTP with App Password)
# To create an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Google Workspace Official OAuth 2.0 Integration (Calendar, Gmail API, Tasks, Drive)
# 1. Download OAuth 2.0 Desktop Client JSON from Google Cloud Console.
# 2. Save it locally as 'credentials/credentials.json' (strictly excluded from Git).
# 3. Run: python -m mcp_servers.google_auth to complete browser consent and generate 'credentials/google_token.json'.

# Default User Preferences
USER_NAME=Student
USER_DEFAULT_EMAIL=student@example.com
DEFAULT_REMINDER_LEAD_HOURS=24

# Administrator Authentication & Security Settings
ADMIN_EMAIL=admin@assistant.local
# Set either pre-hashed bcrypt password or initial setup password:
ADMIN_INITIAL_PASSWORD=AdminSecurePass2026!
# ADMIN_PASSWORD_HASH=$2b$12$...
JWT_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production
SESSION_EXPIRE_MINUTES=120
RESET_TOKEN_EXPIRE_MINUTES=15
APP_BASE_URL=http://localhost:8501
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_RESET_ATTEMPTS=3
